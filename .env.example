# Public Spotify client id (safe to expose in the app bundle)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
spotify_client_id=your_spotify_client_id

# In Spotify Developer Dashboard → your app → Redirect URIs, add ALL of these you use.
# Spotify rejects "localhost" — use 127.0.0.1 for local web:
# - http://127.0.0.1:8081/spotify-callback
# - http://127.0.0.1:8083/spotify-callback
# - metime://spotify-callback
#
# Development Mode also requires the Spotify app owner to have Spotify Premium
# (Web API is blocked otherwise).

# Gemini Live (Soft Talk · Talk with Me) — keep private; do not commit real keys.
# You can also paste the key in Settings → Soft Talk companion (stored on-device).
# Get a key: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
