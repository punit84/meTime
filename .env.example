# Public Spotify client id (safe to expose in the app bundle)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
spotify_client_id=your_spotify_client_id

# In Spotify Developer Dashboard → your app → Redirect URIs, add ALL of these you use:
# - http://localhost:8081/spotify-callback
# - http://localhost:8083/spotify-callback
# - metime://spotify-callback
