{
  "expo": {
    "name": "MeTime",
    "slug": "metime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metime",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MeTime uses the camera for your private Mirror mode.",
        "NSMicrophoneUsageDescription": "MeTime uses the microphone so you can talk to yourself in private voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EE"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MeTime to use the camera for private Mirror mode."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow MeTime to record private voice notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
